page {
  height: 100vh;
  overflow: hidden;
}

.container {
  height: 100vh;
  padding: 16rpx 28rpx calc(140rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-color);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.week-pills {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-pill);
  padding: 8rpx 12rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 12rpx;
  flex-shrink: 0;
}

.pill {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-sub);
  border-radius: 50%;
  transition: all 0.25s cubic-bezier(0.1, 0.7, 0.1, 1);
}

.pill.active {
  background: var(--primary-color);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(80, 43, 216, 0.3);
}

.timeline-box {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.timeline-item {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  position: relative;
}

.time-col {
  width: 140rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  padding-right: 12rpx;
}

.time-text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
}

.time-slot-name {
  font-size: 18rpx;
  color: var(--text-sub);
  line-height: 1.2;
  margin-top: 2rpx;
}

.divider {
  width: 44rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  position: relative;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #D8DBE1;
  border-radius: 50%;
  z-index: 2;
  transition: all 0.25s ease;
}

.active-dot {
  background: var(--primary-color);
  box-shadow: 0 0 0 4rpx rgba(80, 43, 216, 0.16);
}

.line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #E8EBEF;
  z-index: 1;
}

.timeline-item:first-child .line {
  top: 50%;
}

.timeline-item:last-child .line {
  bottom: 50%;
}

.content-col {
  flex: 1;
  min-height: 0;
  height: 100%;
  display: flex;
  align-items: center;
  padding: 3rpx 0 3rpx 10rpx;
  box-sizing: border-box;
}

.course-card {
  width: 100%;
  height: calc(100% - 6rpx);
  min-height: 48rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.course-card.active {
  background: linear-gradient(135deg, #502BD8 0%, #7451FF 100%);
  color: #fff;
  padding: 0 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(80, 43, 216, 0.18);
}

.course-title {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.course-card.empty {
  background: rgba(255, 255, 255, 0.45);
  border: 1rpx dashed #E2E6EC;
  padding: 0 20rpx;
}

.empty-text {
  font-size: 20rpx;
  color: #B0B6C2;
  font-weight: 500;
}
