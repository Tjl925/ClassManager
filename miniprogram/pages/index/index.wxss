/* 一屏锁定：整页不滚动，纵向空间由 flex 分配（与课表页/概览页同一套做法，见 D011） */
page {
  height: 100vh;
  overflow: hidden;
}

.container {
  height: 100vh;
  padding: 32rpx 40rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  /* 多余空间均分到 hero / 卡片区 / 按钮区 / 进度轴 之间的三个间隙，
     进度轴因此被推到底部栏上方，上方内容均匀撑满，不会挤在屏幕顶部 */
  justify-content: space-between;
  overflow: hidden;
}
.hero {
  margin-bottom: 28rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.greeting {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  line-height: 1.2;
}
.recommend-badge {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(0, 196, 140, 0.1);
  color: var(--success-color);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  font-weight: 600;
}
.recommend-badge .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--success-color);
  margin-right: 12rpx;
}
.bento-box {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.bento-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: transform 0.4s cubic-bezier(0.1, 0.7, 0.1, 1);
}
.card-label {
  font-size: 28rpx;
  color: var(--text-sub);
  width: 100rpx;
}
.card-value {
  font-size: 34rpx;
  font-weight: 700;
  flex: 1;
  text-align: right;
  padding-right: 20rpx;
}
.ppt-text {
  font-size: 30rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.icon-arrow {
  width: 12rpx;
  height: 12rpx;
  border-top: 4rpx solid #ccc;
  border-right: 4rpx solid #ccc;
  transform: rotate(45deg);
}
.state-card {
  display: block;
}
.state-card .card-label {
  display: block;
  margin-bottom: 16rpx;
}
.toggle-group {
  display: flex;
  background: var(--bg-color);
  border-radius: var(--radius-pill);
  padding: 8rpx;
}
.toggle-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-sub);
  transition: all 0.3s cubic-bezier(0.1, 0.7, 0.1, 1);
}
.active-success {
  background: var(--card-bg);
  color: var(--success-color);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.active-warning {
  background: var(--card-bg);
  color: var(--warning-color);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.expand-input {
  display: none;
  justify-content: center;
  gap: 20rpx;
  background: transparent;
  box-shadow: none;
  padding: 4rpx;
}
.expand-input.show {
  display: flex;
}
.glass-input {
  background: #E8EBEF;
  border-radius: 20rpx;
  height: 88rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  width: 160rpx;
  color: var(--primary-color);
}
.total-fixed {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.ph-style {
  color: #B0B5C0;
  font-weight: 500;
  font-size: 28rpx;
}
.slash {
  font-size: 48rpx;
  color: #D1D5DB;
  font-weight: 300;
}
.action-bar {
  margin: 24rpx 0 0;
  flex-shrink: 0;
}
.btn-submit {
  background: var(--primary-color);
  color: #fff;
  height: 96rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: var(--shadow-md);
  letter-spacing: 2rpx;
}
.spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255,255,255,0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.history-badge { font-size: 24rpx; color: var(--text-sub); display: flex; align-items: center; padding: 0 10rpx; margin-top: -10rpx; }
.history-dot { width: 10rpx; height: 10rpx; border-radius: 50%; margin-right: 12rpx; }
.bg-success { background: var(--success-color); }
.bg-warning { background: var(--warning-color); }

/* ==================== 撤销入口 ==================== */
/* 中性外观：不用橙色表达"危险" —— 橙是「未讲完」的保留状态色，会撞语义（D008） */
.btn-undo {
  margin-top: 14rpx;
  height: 74rpx;
  border-radius: var(--radius-pill);
  background: var(--card-bg);
  color: var(--text-sub);
  border: 2rpx solid #E4E8EE;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}
.undo-icon {
  font-size: 32rpx;
  line-height: 1;
}
/* 无可撤销记录：保持同样的尺寸与位置，只降对比度，避免出现/消失导致布局跳动 */
.btn-undo.is-disabled {
  color: #C4C9D2;
  background: rgba(255, 255, 255, 0.5);
  border-color: #EDF0F4;
  box-shadow: none;
}

/* ==================== 横向进度轴 ==================== */
.track-section {
  margin-top: 24rpx;
  /* 不参与伸缩：多余空间交给容器的 space-between 分配，进度轴保持自然高度沉在底部 */
  flex-shrink: 0;
  display: flex;
  align-items: center;
  overflow: hidden;
}
/* 横向滚动的经典写法：容器 nowrap + 内层 inline-flex */
.track-scroll {
  width: 100%;
  white-space: nowrap;
}
.track-inner {
  display: inline-flex;
  /* ⚠ 必须与 index.js 的 TRACK_PAD_RPX 保持一致，值为 (750 - NODE_W_RPX)/2 = (750-180)/2 = 285 */
  /* 对称大边距的作用：让第 1 讲和第 23 讲也能滚到屏幕正中，而不是贴边 */
  padding: 0 285rpx;
}
.track-node {
  width: 180rpx; /* ⚠ 必须与 index.js 的 NODE_W_RPX 保持一致 */
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.node-num {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-sub);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-pill);
  line-height: 1.2;
  white-space: nowrap;
  transition: all 0.3s cubic-bezier(0.1, 0.7, 0.1, 1);
}
.node-axis {
  display: flex;
  align-items: center;
  width: 100%;
  height: 28rpx;
}
.axis-line {
  flex: 1;
  height: 3rpx;
  background: #E4E8EE;
}
.axis-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #D8DBE1;
  flex-shrink: 0;
  transition: all 0.3s cubic-bezier(0.1, 0.7, 0.1, 1);
}
/* 多行课件名：定高约 3 行，保证 23 个节点等高对齐
   注意不要用 word-break:break-all —— 会把 "1.1.1" 从中间断开。
   中文默认换行已可在任意汉字处折行，同时保证数字/拉丁串完整。 */
.node-name {
  font-size: 20rpx;
  line-height: 1.35;
  color: var(--text-sub);
  white-space: normal;
  word-break: normal;
  overflow-wrap: break-word;
  text-align: center;
  /* 85rpx = 3 行 × (20rpx × 1.35) + 5rpx 内边距，容纳最长的章末课件名（3 行）不被截断 */
  height: 86rpx;
  overflow: hidden;
  padding: 4rpx 6rpx 0;
  box-sizing: border-box;
}
/* 首尾两端不画线，避免轨道越出边界 */
.track-node:first-child .axis-line:first-child { background: transparent; }
.track-node:last-child .axis-line:last-child { background: transparent; }

/* 已讲完：靛蓝是唯一量度色（D008），只用它表达"进度"这一个量度 */
.track-node.is-done .axis-line,
.track-node.is-done .axis-dot {
  background: var(--primary-color);
}
.track-node.is-done .node-num { color: var(--primary-color); }
.track-node.is-done .node-name { color: #A9B0BC; }

/* 当前课件：胶囊 + 白字加粗，靠形状与文字表意，不靠颜色单独表意（D008） */
.track-node.is-current .node-num {
  background: linear-gradient(135deg, #502BD8 0%, #7451FF 100%);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(80, 43, 216, 0.28);
}
.track-node.is-current .axis-dot {
  background: var(--primary-color);
  box-shadow: 0 0 0 5rpx rgba(80, 43, 216, 0.16);
}
.track-node.is-current .node-name {
  color: var(--text-main);
  font-weight: 700;
}

/* ==================== 确认弹窗 ==================== */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000; /* 必须压过悬浮 tab 栏的 999 */
  background: rgba(26, 29, 32, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  box-sizing: border-box;
  animation: maskIn 0.25s ease forwards;
}
@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.modal-card {
  width: 100%;
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx 36rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-md);
}
/* 全局 fadeUp 是 .8s，对确认弹窗太拖；局部压到 .35s，与遮罩的 .25s 对齐 */
.modal-card.animate-fade-up {
  animation-duration: 0.35s;
  animation-delay: 0ms !important;
}
.modal-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: -1rpx;
}
.modal-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-sub);
}
.modal-body {
  margin-top: 32rpx;
  background: var(--bg-color);
  border-radius: 28rpx;
  padding: 20rpx 28rpx;
}
.modal-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}
.modal-key {
  width: 88rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--text-sub);
}
.modal-val {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  text-align: right;
  line-height: 1.4;
}
.val-dot {
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
/* 状态色永远"圆点 + 文字"成对出现，不单独用颜色表意（D008） */
.val-success { color: var(--success-color); }
.val-warning { color: var(--warning-color); }
.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}
.modal-btn {
  flex: 1;
  height: 92rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}
.modal-btn.ghost {
  background: var(--bg-color);
  color: var(--text-sub);
}
.modal-btn.primary {
  background: var(--primary-color);
  color: #fff;
  box-shadow: var(--shadow-md);
}
/* 撤销确认用中性深色：色相不参与表意，"确认撤销"四个字承担全部含义（D008） */
.modal-btn.danger {
  background: var(--text-main);
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(26, 29, 32, 0.22);
}
