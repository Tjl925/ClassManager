.container {
  padding: 60rpx 40rpx 200rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
  box-sizing: border-box;
}
.header {
  margin-bottom: 48rpx;
}
.title {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  display: block;
}
.subtitle {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-top: 12rpx;
  display: block;
}

/* 排名卡片列表 */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.rank-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 36rpx 40rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.4s cubic-bezier(0.1, 0.7, 0.1, 1);
}

/* 头部行 */
.card-head {
  display: flex;
  align-items: center;
}
.class-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: 1rpx;
}
.spacer {
  flex: 1;
}

/* 位置标签 */
.tag {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-sub);
  background: #F2F4F8;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-pill);
}
.tag-lead {
  color: var(--primary-color);
  background: rgba(80, 43, 216, 0.08);
}

/* 主体数字行 */
.hero-row {
  display: flex;
  align-items: baseline;
  margin-top: 28rpx;
}
.hero-num {
  font-size: 76rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--text-main);
}
.hero-total {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-left: 12rpx;
}
.pct {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
}

/* 细进度条：靛蓝是唯一量度色，轨道弱化为浅灰 */
.meter-track {
  height: 12rpx;
  background: #EEF0F4;
  border-radius: var(--radius-pill);
  margin-top: 20rpx;
  overflow: hidden;
}
.meter-fill {
  height: 100%;
  background: var(--primary-color);
  border-radius: 6rpx;
  transition: width 0.6s cubic-bezier(0.1, 0.7, 0.1, 1);
}

/* 课件名 + 状态行 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
}
.ppt-name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.status-chip {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
.dot-success { background: var(--success-color); }
.dot-warning { background: var(--warning-color); }
.status-text {
  font-size: 24rpx;
  font-weight: 700;
}
.text-success { color: var(--success-color); }
.text-warning { color: var(--warning-color); }

.update-time {
  display: block;
  font-size: 20rpx;
  color: #C0C5CF;
  margin-top: 16rpx;
}

.empty-state {
  margin-top: 28rpx;
}
.empty-state text {
  font-size: 26rpx;
  color: #C0C5CF;
  font-weight: 500;
}