page {
  height: 100vh;
  overflow: hidden;
}

.container {
  height: 100vh;
  padding: 24rpx 28rpx calc(140rpx + env(safe-area-inset-bottom));
  background-color: var(--bg-color);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.header {
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  display: block;
}

/* 排名卡片列表：自适应均分垂直视口 */
.rank-list {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 14rpx;
}

.rank-card {
  flex: 1;
  min-height: 0;
  background: var(--card-bg);
  border-radius: 28rpx;
  padding: 20rpx 32rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-sizing: border-box;
  transition: transform 0.3s cubic-bezier(0.1, 0.7, 0.1, 1);
}

/* 头部行 */
.card-head {
  display: flex;
  align-items: center;
}

.class-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: 0.5rpx;
}

.spacer {
  flex: 1;
}

/* 位置标签 */
.tag {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-sub);
  background: #F2F4F8;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-pill);
}

.tag-lead {
  color: var(--primary-color);
  background: rgba(80, 43, 216, 0.08);
}

/* 主体数字行 */
.hero-row {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
}

.hero-num {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1;
  color: var(--text-main);
}

.hero-total {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-left: 8rpx;
}

.pct {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-main);
}

/* 细进度条 */
.meter-track {
  height: 8rpx;
  background: #EEF0F4;
  border-radius: var(--radius-pill);
  margin-top: 10rpx;
  overflow: hidden;
}

.meter-fill {
  height: 100%;
  background: var(--primary-color);
  border-radius: 4rpx;
  transition: width 0.6s cubic-bezier(0.1, 0.7, 0.1, 1);
}

/* 课件名 + 状态行 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 10rpx;
}

.ppt-name {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-main);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-chip {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.dot-success { background: var(--success-color); }
.dot-warning { background: var(--warning-color); }

.status-text {
  font-size: 20rpx;
  font-weight: 700;
}

.text-success { color: var(--success-color); }
.text-warning { color: var(--warning-color); }

.update-time {
  display: block;
  font-size: 18rpx;
  color: #C0C5CF;
  margin-top: 4rpx;
}

.empty-state {
  margin-top: 12rpx;
}

.empty-state text {
  font-size: 22rpx;
  color: #C0C5CF;
  font-weight: 500;
}