.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

/* cool ui 毛玻璃容器：上浮悬浮层 */
.tabbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 0 24rpx 20rpx;
  padding: 14rpx 12rpx;
  border-radius: 9999rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 2rpx solid rgba(80, 43, 216, 0.06);
  box-shadow: 0 16rpx 48rpx rgba(26, 29, 32, 0.1);
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 12rpx;
  border-radius: 9999rpx;
  transition: all 0.25s cubic-bezier(0.1, 0.7, 0.1, 1);
}

.tab-item--active {
  background: linear-gradient(135deg, rgba(80, 43, 216, 0.1), rgba(0, 196, 140, 0.08));
}

.tab-item--press {
  transform: scale(0.96);
}

.tab-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #8E949F;
  line-height: 1.4;
  transition: all 0.25s cubic-bezier(0.1, 0.7, 0.1, 1);
}

.tab-item--active .tab-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #502BD8;
}

/* 选中指示器小圆点 */
.tab-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 9999rpx;
  background: #00C48C;
  margin-top: 6rpx;
  animation: dotPop 0.3s cubic-bezier(0.1, 0.7, 0.1, 1);
}

@keyframes dotPop {
  0% { transform: scale(0); }
  70% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* iPhone 底部安全区 */
.tabbar-safe {
  height: env(safe-area-inset-bottom);
  background: #F2F4F8;
}